{
  "name": "kayak-website",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Kayak product website and static desktop demonstration",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/serve.cjs",
    "start": "node scripts/serve.cjs --dir dist",
    "preview": "node scripts/serve.cjs --dir dist",
    "sync:preview": "node scripts/sync-app-preview.cjs",
    "build": "npm run sync:preview && node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs"
  }
}
